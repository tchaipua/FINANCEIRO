# Esta credencial pertence exclusivamente ao job one-shot de migrations.
# Nunca monte este arquivo ou secret no contêiner do backend.
MIGRATION_DATABASE_URL="postgresql://financeiro_owner:SUBSTITUA@postgres:5432/financeiro?schema=public&sslmode=require&connection_limit=1&connect_timeout=5"

# Em Docker/Kubernetes, prefira remover a variável acima e montar:
# MIGRATION_DATABASE_URL_FILE="/run/secrets/financeiro_migration_database_url"
