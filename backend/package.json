{
  "name": "financeiro-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Core financeiro multiempresa desacoplado",
  "scripts": {
    "prestart": "prisma generate",
    "prestart:dev": "prisma generate",
    "prestart:prod": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postgresql:schema:sync": "node scripts/sync-postgresql-schema.mjs",
    "postgresql:schema:check": "node scripts/sync-postgresql-schema.mjs --check",
    "postgresql:generate": "npm run postgresql:schema:sync && prisma generate --schema prisma/postgresql/schema.prisma",
    "postgresql:migrate:deploy": "node scripts/deploy-postgresql-migrations.mjs",
    "test:core": "npm run build && node test/finance-core.test.cjs",
    "test:nfce": "npm run build && ts-node test/nfce-core.test.ts && node test/nfce-flow.test.cjs",
    "test:nfe": "npm run build && ts-node test/brazil-tax-id.test.ts && ts-node test/nfe-core.test.ts",
    "test:nfse": "npm run build && ts-node test/nfse-core.test.ts",
    "test:supertef": "npm run build && ts-node test/supertef-core.test.ts",
    "test:printing": "npm run build && ts-node test/printing-core.test.ts",
    "test:security": "npm run build && node test/security-containment.test.cjs && node test/internal-api-auth.test.cjs && node test/source-system-callback.test.cjs && node test/download-response.test.cjs && node test/s3-upload-security.test.cjs && node test/security-runtime.test.cjs && node test/deployment-security.test.cjs",
    "test:nfce:homologation": "ts-node scripts/nfce-homologation-smoke.ts",
    "sefaz:cadastro": "ts-node scripts/sefaz-cadastro-query.ts",
    "tenant:provision": "ts-node scripts/provision-finance-tenant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.10.2",
    "@xmldom/xmldom": "^0.9.10",
    "busboy": "^1.6.0",
    "bwip-js": "^4.11.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.7.3",
    "helmet": "^8.3.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/busboy": "^1.5.4",
    "@types/bwip-js": "^3.2.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
