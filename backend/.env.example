NODE_ENV="development"
PORT=3002
FINANCEIRO_BIND_HOST="127.0.0.1"
DATABASE_URL="file:../dev.db"
MSINFOR_CENTRAL_API_URL="http://127.0.0.1:3201/api/v1"
MSINFOR_CENTRAL_FRONTEND_URL="http://localhost:3200"
MSINFOR_CENTRAL_SYSTEM_KEY="substitua-por-uma-chave-hmac-com-no-minimo-32-bytes"
# SQLite é usado somente no desenvolvimento/teste local. Produção usa o
# schema paralelo prisma/postgresql/schema.prisma e um papel sem DDL/ownership.
FINANCEIRO_CERTIFICATE_SECRET="SUBSTITUA-POR-64-CARACTERES-ALEATORIOS-E-EXCLUSIVOS"
FINANCEIRO_APP_SECRET="SUBSTITUA-POR-OUTRA-CHAVE-FORTE-E-EXCLUSIVA"
FINANCEIRO_HMAC_ESCOLA_SECRET="CHAVE-ALEATORIA-EXCLUSIVA-DA-ESCOLA-COM-64-CARACTERES"
FINANCEIRO_HMAC_PROJETO_INICIAL_SECRET="OUTRA-CHAVE-ALEATORIA-EXCLUSIVA-DO-PROJETO-INICIAL"
FINANCEIRO_HMAC_TIMESTAMP_WINDOW_MS=60000
FINANCEIRO_HMAC_REPLAY_CACHE_MAX_ENTRIES=50000
FINANCEIRO_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3100,http://localhost:3003"
FINANCEIRO_BODY_LIMIT="2mb"
FINANCEIRO_UPLOAD_LIMIT_MB=25
FINANCEIRO_RATE_LIMIT_TTL_MS=60000
FINANCEIRO_RATE_LIMIT_REQUESTS=120
FINANCEIRO_SWAGGER_ENABLED=true
FINANCEIRO_TRUST_PROXY_HOPS=0
FINANCEIRO_SICOOB_POWERSHELL_ENABLED=false
SOURCE_SYSTEM_ESCOLA_API_URL="http://localhost:3001/api/v1"
SOURCE_SYSTEM_ESCOLA_HMAC_SECRET="CHAVE-DIRECIONAL-FINANCEIRO-PARA-ESCOLA-COM-64-CARACTERES"
SOURCE_SYSTEM_PROJETO_INICIAL_API_URL="http://localhost:3101/api/v1"
SOURCE_SYSTEM_PROJETO_INICIAL_HMAC_SECRET="CHAVE-DIRECIONAL-FINANCEIRO-PARA-PROJETO-COM-64-CARACTERES"

# Em produção:
# - use NODE_ENV="production";
# - deixe FINANCEIRO_ALLOWED_ORIGINS vazio; navegadores não acessam esta API;
# - mantenha FINANCEIRO_SWAGGER_ENABLED=false;
# - use FINANCEIRO_BIND_HOST="127.0.0.1" atrás do proxy reverso, ou o IP privado;
# - ajuste FINANCEIRO_TRUST_PROXY_HOPS para a quantidade exata de proxies confiáveis.
# - mantenha relógios sincronizados por NTP e todas as chaves HMAC em secret manager;
# - use chaves exclusivas por sistema e por direção.
