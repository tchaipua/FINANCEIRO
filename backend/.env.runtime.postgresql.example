NODE_ENV="production"
PORT=3002
FINANCEIRO_BIND_HOST="0.0.0.0"

# Use SOMENTE o papel sem ownership/DDL. Senhas devem estar percent-encoded.
# Em Docker, prefira remover DATABASE_URL e montar o valor em:
# DATABASE_URL_FILE="/run/secrets/financeiro_database_url"
DATABASE_URL="postgresql://financeiro_runtime:SUBSTITUA@postgres:5432/financeiro?schema=public&sslmode=require&sslaccept=strict&sslrootcert=/run/secrets/postgres_tls_ca.pem&connection_limit=10&pool_timeout=10&connect_timeout=5"
FINANCEIRO_DATABASE_RUNTIME_ROLE="financeiro_runtime"
FINANCEIRO_DATABASE_REQUIRE_LEAST_PRIVILEGE="true"

FINANCEIRO_CERTIFICATE_SECRET="SUBSTITUA-POR-UM-SEGREDO-ALEATORIO-DE-64-CARACTERES"
FINANCEIRO_HMAC_ESCOLA_SECRET="SUBSTITUA-POR-CHAVE-ALEATORIA-EXCLUSIVA-DA-ESCOLA"
FINANCEIRO_HMAC_PROJETO_INICIAL_SECRET="SUBSTITUA-POR-CHAVE-ALEATORIA-EXCLUSIVA-DO-PROJETO"
SOURCE_SYSTEM_ESCOLA_HMAC_SECRET="SUBSTITUA-POR-CHAVE-DIRECIONAL-FINANCEIRO-PARA-ESCOLA"
SOURCE_SYSTEM_PROJETO_INICIAL_HMAC_SECRET="SUBSTITUA-POR-CHAVE-DIRECIONAL-FINANCEIRO-PARA-PROJETO"

# A API fica apenas na rede interna e não aceita navegadores diretamente.
FINANCEIRO_ALLOWED_ORIGINS=""
FINANCEIRO_SWAGGER_ENABLED="false"
FINANCEIRO_TRUST_PROXY_HOPS=1
FINANCEIRO_BODY_LIMIT="2mb"
FINANCEIRO_UPLOAD_LIMIT_MB=25
FINANCEIRO_RATE_LIMIT_TTL_MS=60000
FINANCEIRO_RATE_LIMIT_REQUESTS=120
FINANCEIRO_HMAC_TIMESTAMP_WINDOW_MS=60000
FINANCEIRO_HMAC_REPLAY_CACHE_MAX_ENTRIES=50000

# O banco já armazena XML/PDF. Este modo permite root filesystem read-only.
FINANCEIRO_FISCAL_ARTIFACT_STORAGE_MODE="database"

# Bloqueado na imagem Linux até a integração ser portada de PowerShell para
# Node.js com mTLS e sem segredos em argumentos de processo.
FINANCEIRO_SICOOB_POWERSHELL_ENABLED="false"
